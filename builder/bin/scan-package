#!/bin/bash
# Malware gate for a built package, run from the directory holding the built
# *.pkg.tar.zst files. Exit status: 0 clean, 1 malware, 2 error; on 1/2 a
# one-line summary is printed to stdout, diagnostics go to stderr.

set -e

conf="$(dirname "$(readlink -f "$0")")/../clamd.conf"

freshclam --quiet >&2 || echo "ClamAV: freshclam failed, using the cached database" >&2

mkdir -p /run/clamav
clamd --config-file="$conf"
for _ in $(seq 60); do
  [ -S /run/clamav/clamd.sock ] && break
  sleep 1
done

# makepkg stages each split under build/<pkgbase>/pkg; pkgbase comes from the
# PKGBUILD and may differ from the repository name, so match by built names.
pkgdirbase=
for cand in $(find /mnt -maxdepth 5 -type d -path '*/build/*/pkg' -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2-); do
  for d in "$cand"/*/; do
    n=$(basename "$d")
    for pkg in *.pkg.tar.zst; do
      if [[ "$pkg" == "$n"-* ]]; then
        pkgdirbase="$cand"
        break 3
      fi
    done
  done
done
if [ -z "$pkgdirbase" ]; then
  echo "ClamAV: no pkgdir found"
  exit 2
fi

work=$(mktemp -d)
for pkg in *.pkg.tar.zst; do
  mkdir "$work/${pkg%.pkg.tar.zst}"
  if ! bsdtar -xf "$pkg" -C "$work/${pkg%.pkg.tar.zst}" --include '.*' >&2; then
    rm -rf "$work"
    echo "ClamAV: failed to extract $pkg metadata"
    exit 2
  fi
done

rc=0
: > /tmp/clamdscan.log
for d in "$pkgdirbase" "$work"; do
  r=0
  clamdscan --config-file="$conf" --multiscan --fdpass "$d" >> /tmp/clamdscan.log || r=$?
  if [ "$r" -eq 1 ]; then
    rc=1
  elif [ "$r" -ne 0 ] && [ "$rc" -ne 1 ]; then
    rc=2
  fi
done
rm -rf "$work"

if [ "$rc" -eq 1 ]; then
  grep ' FOUND$' /tmp/clamdscan.log | sed -e "s#^$pkgdirbase/[^/]*/##" -e "s#^$work/[^/]*/##" -e 's/ FOUND$//' >&2
  hits=$(grep -c ' FOUND$' /tmp/clamdscan.log || true)
  first=$(grep ' FOUND$' /tmp/clamdscan.log | head -1 | sed -e "s#^$pkgdirbase/[^/]*/##" -e "s#^$work/[^/]*/##" -e 's/ FOUND$//')
  summary="${first:0:170}"
  if [ "$hits" -gt 1 ]; then
    summary="$summary (+$((hits-1)) more)"
  fi
  echo "$summary"
  exit 1
fi
if [ "$rc" -ne 0 ]; then
  echo "ClamAV: scan error"
  exit 2
fi
